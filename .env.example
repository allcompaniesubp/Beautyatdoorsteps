# DoorSphere development environment
# Supabase project URL and publishable/anon key are public client configuration.
# Add real values only to your local .env.local or hosting environment; never commit them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Leave unset until a reviewed server-side admin workflow needs it.
# NEVER prefix this key with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
